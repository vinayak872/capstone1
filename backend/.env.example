PORT=3001
K8S_NAMESPACE=cloud05
ARGOCD_NAMESPACE=argocd
ARGOCD_APPLICATION=cloud05-app
PROMETHEUS_URL=http://localhost:9090
BACKEND_APP_URL=http://localhost:8080
POLL_INTERVAL_MS=5000
ENABLE_SSE=true

# PromQL Queries Configurable
PROMQL_REQUEST_RATE=sum(rate(http_requests_total[1m])) or vector(0)
PROMQL_ERROR_RATE=(sum(rate(http_requests_total{status_code=~"5.."}[1m])) / sum(rate(http_requests_total[1m])) * 100) or vector(0)
PROMQL_P95_LATENCY=histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le)) * 1000 or vector(0)
PROMQL_SUCCESS_RATE=(sum(rate(http_requests_total{status_code!~"5.."}[1m])) / sum(rate(http_requests_total[1m])) * 100) or vector(100)
PROMQL_AVAILABILITY=(sum(rate(http_requests_total{status_code!~"5.."}[5m])) / sum(rate(http_requests_total[5m])) * 100) or vector(100)
